{
  "metadata": [
    {
      "src": [
        {
          "src": "../Source",
          "files": [
            "ContentContent.Dialog/ContentContent.Dialog.csproj",
            "ContentContent.Dialog.Unity/Runtime/**/*.cs"
          ]
        }
      ],
      "dest": "api",
      "includePrivateMembers": false,
      "disableGitFeatures": false,
      "disableDefaultFilter": false,
      "noRestore": false,
      "namespaceLayout": "flattened",
      "memberLayout": "samePage",
      "allowCompilationErrors": true
    }
  ],
  "build": {
    "content": [
      {
        "files": [
          "api/**.yml"
        ]
      },
      {
        "files": [
          "docs/**.md",
          "docs/**/toc.yml",
          "toc.yml",
          "index.md"
        ]
      }
    ],
    "resource": [
      {
        "files": [
          "images/**"
        ]
      }
    ],
    "output": "_site",
    "template": [
      "default",
      "modern"
    ],
    "globalMetadata": {
      "_appTitle": "ContentContent Dialog System",
      "_appName": "ContentContent.Dialog",
      "_enableSearch": true,
      "_enableNewTab": true,
      "_disableContribution": false
    }
  }
}